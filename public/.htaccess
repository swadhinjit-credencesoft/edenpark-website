Options -MultiViews
DirectoryIndex index.html
RewriteEngine On

# ---------- 1. Real files: serve as-is ----------
# _next/static/*, assets/*, robots.txt, sitemap.xml, *.html, *.txt, etc.
RewriteCond %{REQUEST_FILENAME} -f
RewriteRule ^ - [L]

# ---------- 2. Real directory that HAS an index.html: serve as-is ----------
RewriteCond %{REQUEST_FILENAME} -d
RewriteCond %{REQUEST_FILENAME}/index.html -f
RewriteRule ^ - [L]

# ---------- 3. Trailing slash: drop it (301) ----------
# Prevents 403 on real directories without an index (e.g. /blog/) and
# keeps canonical URLs clean: /rooms/ -> /rooms, /blog/ -> /blog.
RewriteRule ^(.+)/$ /$1 [R=301,L]

# ---------- 4. Extensionless -> .html ----------
# /rooms -> rooms.html, /blog -> blog.html, /blog/slug -> blog/slug.html
RewriteCond %{REQUEST_FILENAME}.html -f
RewriteRule ^(.+)$ /$1.html [L]

# ---------- 5. Custom 404 ----------
ErrorDocument 404 /404.html