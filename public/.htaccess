RewriteEngine On

# ---------- Serve real files & directories as-is ----------
# _next/static/*, assets/*, robots.txt, sitemap.xml, llms.txt, etc.
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# ---------- Canonical: drop trailing slash ----------
# /rooms/ → /rooms  (all internal links & sitemap use extensionless)
RewriteRule ^(.+)/$ /$1 [R=301,L]

# ---------- Extensionless → .html ----------
# /rooms → rooms.html, /blog → blog.html, /find-us → find-us.html, etc.
RewriteCond %{REQUEST_FILENAME}.html -f
RewriteRule ^(.+)$ /$1.html [L]

# ---------- Custom 404 ----------
ErrorDocument 404 /404.html
